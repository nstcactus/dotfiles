#!/usr/bin/env bash
set -xeuo pipefail

echo "🔍 Checking for Homebrew/Linuxbrew installation…"

if command -v brew >/dev/null 2>&1; then
  echo "✅ Homebrew is already installed."
else
  {{ if eq .chezmoi.os "darwin" }}
  echo "🍎 Installing Homebrew …"
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  {{ else if eq .chezmoi.os "linux" }}
  echo "🐧 Installing Linuxbrew…"

  # Add linuxbrew user if missing
  if ! id -u linuxbrew >/dev/null 2>&1; then
    echo "👤 Adding a linuxbrew user…"
    sudo useradd -m -s /bin/bash linuxbrew
  else
    echo "👤 linuxbrew user already exists."
  fi

  # Install basic build tools
  if command -v apt >/dev/null 2>&1; then
    sudo apt-get update
    sudo apt-get install -y build-essential curl file git
  elif command -v dnf >/dev/null 2>&1; then
    sudo dnf install -y @development-tools curl file git
  elif command -v pacman >/dev/null 2>&1; then
    sudo pacman -Sy --needed base-devel curl file git
  else
    echo "❌ Unsupported package manager. Install build tools manually."
    exit 1
  fi

  # Install Linuxbrew as linuxbrew user
  sudo -u linuxbrew env NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

  # Add brew wrapper script, ensure /tmp cwd
  echo "📟 Adding a /usr/local/bin/brew wrapper script to run brew as linuxbrew…"
  sudo tee /usr/local/bin/brew > /dev/null <<'EOF'
#!/bin/bash
cd /tmp || exit 1
sudo -u linuxbrew /home/linuxbrew/.linuxbrew/bin/brew "$@"
EOF
  sudo chmod +x /usr/local/bin/brew

  {{ end }}
  echo "✅ Homebrew installed."
fi

# -----------------------------
# Brew package installation
# -----------------------------

# Base packages (always installed)
BASE_PACKAGES=("git" "zsh" "thefuck" "aria2" "node")

# Workstation packages (optional)
WORKSTATION_PACKAGES=("ddev/ddev" "ddev" "git-standup" "php" "composer" "node" "mkcert" "yt-dlp")

# Ask user if they want workstation packages
read -p "Do you want to install workstation packages? [y/N] " REPLY
if [[ "$REPLY" =~ ^[Yy]$ ]]; then
  PACKAGES=("${BASE_PACKAGES[@]}" "${WORKSTATION_PACKAGES[@]}")
else
  PACKAGES=("${BASE_PACKAGES[@]}")
fi

echo "📦 Installing Brew packages…"
for pkg in "${PACKAGES[@]}"; do
  brew list "$pkg" >/dev/null 2>&1 || brew install "$pkg"
done
echo "✅ Brew packages installed."
